# --- Obligatoire pour la catégorisation automatique ---
ANTHROPIC_API_KEY=

# --- Optionnel ---
PORT=3000
# Dossier surveillé pour l'import automatique (par défaut: ./watched)
WATCH_DIR=
# Modèle utilisé pour catégoriser (par défaut: claude-sonnet-4-6)
CATEGORIZE_MODEL=

# --- Import Google Drive (optionnel) ---
# 1. Crée un OAuth Client ID (type "Desktop app") dans Google Cloud Console
# 2. Renseigne GOOGLE_CLIENT_ID et GOOGLE_CLIENT_SECRET ci-dessous
# 3. Lance `npm run drive:auth` et suis les instructions pour obtenir GOOGLE_REFRESH_TOKEN
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
# ID du dossier Drive à synchroniser (visible dans l'URL du dossier sur drive.google.com)
DRIVE_FOLDER_ID=
