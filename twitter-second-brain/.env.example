# ---------------------------------------------------------------------------
# Copy this file to `.env` and fill it in. `.env` is gitignored — NEVER commit it.
# ---------------------------------------------------------------------------

# --- X / Twitter account used by collectors/collect_twscrape.py -------------
# ⚠️ Use a SECONDARY, dedicated account — scraping can get an account suspended.
X_USERNAME=your_secondary_handle
X_PASSWORD=your_password
X_EMAIL=your_account_email@example.com
X_EMAIL_PASSWORD=your_email_password

# Optional: paste a logged-in cookie string to skip password login challenges.
# (Export cookies from a browser session of the same account.)
# X_COOKIES=auth_token=...; ct0=...

# --- Anthropic API key used by ask_brain.py (the AI Q&A over your brain) -----
# Get one at https://console.anthropic.com/ . Or run `ant auth login` instead
# and leave this unset — the SDK will pick up the profile automatically.
ANTHROPIC_API_KEY=sk-ant-...
