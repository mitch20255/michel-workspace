# Clés pour la génération vidéo (côté serveur uniquement, jamais dans le navigateur).
# Copiez ce fichier en .env et renseignez au moins une clé selon le fournisseur choisi.

# Replicate — accès unifié aux derniers modèles (Google Veo 3, Kling, Luma, MiniMax, Wan…)
# https://replicate.com/account/api-tokens
REPLICATE_API_TOKEN=

# OpenAI — API Vidéos (Sora 2 / Sora 2 Pro)
# https://platform.openai.com/api-keys
OPENAI_API_KEY=

# Google — API Gemini (Veo 3.x)
# https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Port du backend vidéo (facultatif)
# PORT=8787
