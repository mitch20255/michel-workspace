# Copie ce fichier en .env (ou exporte les variables) puis lance `npm start`.

# URL de base de l'API. Par défaut : https://civitai.red
# Bascule sur https://civitai.com si le miroir est indisponible.
CIVITAI_BASE_URL=https://civitai.red

# Clé d'API (optionnelle) : nécessaire pour les modèles restreints et pour
# augmenter les quotas. À créer depuis ton compte Civitai → Account settings → API Keys.
CIVITAI_API_KEY=

# Port et interface d'écoute du serveur local
PORT=5173
HOST=127.0.0.1

# Réglages avancés
CIVITAI_TIMEOUT_MS=30000
CIVITAI_CACHE_TTL_MS=60000
