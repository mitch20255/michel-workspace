# =============================================================================
# Boussole — exemple de configuration.
# Copier vers `.env` puis remplir. `.env` n'est JAMAIS commité (voir .gitignore).
# Aucune valeur ci-dessous n'est un secret réel.
# =============================================================================

# ⚠️  Ne pas définir NODE_ENV ici.
#
# Ce fichier est partagé par l'API et l'interface web. Un NODE_ENV=development
# exporté dans l'environnement casse `next build` : Next compile pour la
# production pendant que React résout sa version de développement, et l'erreur
# obtenue — « Cannot read properties of null (reading 'useContext') » — ne
# désigne pas du tout la cause. Chaque commande définit son propre mode.

# --- Base de données -----------------------------------------------------
# Postgres 16 + extension pgvector (fournie par infra/docker-compose.yml).
DATABASE_URL="postgresql://boussole:boussole@localhost:5432/boussole?schema=public"

# --- Chiffrement applicatif ----------------------------------------------
# Clé AES-256-GCM utilisée pour chiffrer au repos les champs sensibles du
# profil candidat et les clés API BYOK.
# Générer avec :  openssl rand -base64 32
# ⚠️  Perdre cette clé = perdre l'accès aux champs chiffrés. Sauvegarder hors du repo.
ENCRYPTION_KEY=""

# --- API -----------------------------------------------------------------
API_PORT=4000
API_HOST="127.0.0.1"
# Mode mono-utilisateur (MVP) : jeton statique exigé sur chaque appel API.
# Générer avec :  openssl rand -hex 32
API_TOKEN=""
# Origines autorisées pour CORS, séparées par des virgules.
CORS_ORIGINS="http://localhost:3000"

# --- Web -----------------------------------------------------------------
NEXT_PUBLIC_APP_NAME="Boussole"
# URL de l'API appelée côté serveur Next.js (jamais exposée au navigateur).
API_BASE_URL="http://127.0.0.1:4000"

# --- LLM (BYOK — Bring Your Own Key) -------------------------------------
# Le LLM est DÉSACTIVÉ par défaut. Tant que LLM_PROVIDER=none, aucune donnée
# ne quitte la machine. Valeurs possibles : none | anthropic | openai | ollama
LLM_PROVIDER="none"
LLM_MODEL=""
# Clé fournie par l'utilisateur. Peut aussi être stockée chiffrée en base
# via l'interface (préférable) plutôt qu'en variable d'environnement.
LLM_API_KEY=""
# Endpoint local pour Ollama (aucune donnée ne sort du réseau local).
OLLAMA_BASE_URL="http://127.0.0.1:11434"
# Garde-fou : refuse d'envoyer un prompt dépassant cette taille (caractères).
LLM_MAX_PROMPT_CHARS=24000

# --- Ingestion -----------------------------------------------------------
# Délai minimum entre deux requêtes vers un même hôte ATS (ms). Politesse.
INGEST_MIN_DELAY_MS=1000
INGEST_USER_AGENT="Boussole/0.1 (assistant personnel de recherche d'emploi; contact: you@example.com)"
INGEST_TIMEOUT_MS=15000

# --- Génération documentaire ---------------------------------------------
# Chemin du binaire Typst. Si absent, la génération PDF est désactivée mais
# les sources .typ et le texte brut restent produits.
TYPST_BIN="typst"
STORAGE_DIR="./storage"

# --- Observabilité -------------------------------------------------------
LOG_LEVEL="info"
# Ne jamais mettre à false en production : masque les PII dans les logs.
LOG_REDACT_PII=true
